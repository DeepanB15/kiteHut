# ============================================================
# RepoLens — Development Environment
# Loaded when ENVIRONMENT=development
# ============================================================

ENVIRONMENT=development

API_HOST=0.0.0.0
API_PORT=8000

# SQLite for local development (no Docker required)
DATABASE_URL=sqlite:///repolens.db

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

CORS_ORIGINS=http://localhost:5173,http://localhost:8080

ALLOWED_REPOSITORY_HOSTS=github.com
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_PER_MINUTE=120

# GitHub Integration (Phase 9)
GITHUB_API_URL=https://api.github.com
# GITHUB_TOKEN=github_pat_...
PR_MAX_CHANGED_FILES=100
PR_POST_COMMENT=true
PR_POST_STATUS_CHECK=true
QUALITY_GATE_CONTEXT=RepoLens/Quality-Gate

# Quality Gate (Phase 9)
QUALITY_GATE_CRITICAL_LIMIT=0
QUALITY_GATE_SECURITY_LIMIT=0
QUALITY_GATE_MIN_HEALTH=60

# Notifications (Phase 10)
# NOTIFICATION_WEBHOOK_URL=https://hooks.example.com/xyz

LOG_LEVEL=info