# ============================================================
# RepoLens — Production Environment
# Loaded when ENVIRONMENT=production
#
# WARNING: replace every placeholder with real values. Never
# commit real credentials — inject them via the deployment
# platform (Docker secrets, env files, vault, etc.).
# ============================================================

ENVIRONMENT=production

API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL in production
DATABASE_URL=postgresql://repolens:CHANGE_ME_PASSWORD@postgres:5432/repolens_db

POSTGRES_USER=repolens
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
POSTGRES_DB=repolens_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

LLM_PROVIDER=ollama
# Inside Docker Compose the Ollama service is reachable by name
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b

# Production frontend origin(s) — restrict to your real domain(s)
CORS_ORIGINS=https://repolens.example.com

ALLOWED_REPOSITORY_HOSTS=github.com
MAX_REQUEST_BYTES=1048576
# Stricter limit for production (0 disables rate limiting)
RATE_LIMIT_PER_MINUTE=60

# GitHub Integration (Phase 9)
# GITHUB_TOKEN=github_pat_CHANGE_ME
GITHUB_API_URL=https://api.github.com
# GITHUB_WEBHOOK_SECRET=CHANGE_ME_RANDOM_STRING
PR_MAX_CHANGED_FILES=100
PR_POST_COMMENT=true
PR_POST_STATUS_CHECK=true
QUALITY_GATE_CONTEXT=RepoLens/Quality-Gate

# Quality Gate (Phase 9)
QUALITY_GATE_CRITICAL_LIMIT=0
QUALITY_GATE_SECURITY_LIMIT=0
QUALITY_GATE_MIN_HEALTH=60

# Notifications (Phase 10)
# NOTIFICATION_WEBHOOK_URL=https://hooks.example.com/xyz

LOG_LEVEL=info