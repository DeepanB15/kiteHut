# ============================================================
# RepoLens — Environment Configuration Template
# ============================================================
# Copy this file to .env (or use .env.development / .env.production)
# and adjust the values for your environment.
#
# NEVER commit real secrets. All values below are placeholders.
# ============================================================

# ------------------------------------------------------------
# Environment: development | production | testing
# ------------------------------------------------------------
ENVIRONMENT=development

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# ------------------------------------------------------------
# Database
# SQLite (default, no Docker needed):
# ------------------------------------------------------------
DATABASE_URL=sqlite:///repolens.db

# PostgreSQL (uncomment when using Docker):
# DATABASE_URL=postgresql://repolens:repolens_password@localhost:5432/repolens_db

# PostgreSQL component settings (used when DATABASE_URL is not set)
POSTGRES_USER=repolens
POSTGRES_PASSWORD=change-me
POSTGRES_DB=repolens_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------
# LLM Provider (Ollama)
# ------------------------------------------------------------
LLM_PROVIDER=ollama
# Inside Docker Compose, use http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# ------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# ------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
# Allowed repository hosts (comma-separated)
ALLOWED_REPOSITORY_HOSTS=github.com
# Maximum request body size in bytes (1 MB default)
MAX_REQUEST_BYTES=1048576
# Per-IP requests per minute (0 disables rate limiting)
RATE_LIMIT_PER_MINUTE=120

# ------------------------------------------------------------
# GitHub Integration (Phase 9)
# ------------------------------------------------------------
# Personal Access Token (optional — needed for private repos + PR comments)
# GITHUB_TOKEN=github_pat_...
GITHUB_API_URL=https://api.github.com
# Shared secret for the webhook receiver (HMAC verification)
# GITHUB_WEBHOOK_SECRET=change-me
# Max changed files scanned per PR analysis
PR_MAX_CHANGED_FILES=100
# Post a summary comment back to the PR (true/false)
PR_POST_COMMENT=true
# Post the quality gate verdict as a commit status check on the PR head commit
PR_POST_STATUS_CHECK=true
# Context shown for the status check in the GitHub PR checks UI
QUALITY_GATE_CONTEXT=RepoLens/Quality-Gate

# ------------------------------------------------------------
# Quality Gate (Phase 9)
# ------------------------------------------------------------
# A PR analysis FAILS the gate when any of these limits are exceeded
QUALITY_GATE_CRITICAL_LIMIT=0
QUALITY_GATE_SECURITY_LIMIT=0
QUALITY_GATE_MIN_HEALTH=60

# ------------------------------------------------------------
# Notifications (Phase 10)
# ------------------------------------------------------------
# Optional webhook receiving notification JSON when analyses complete
# (Slack / Discord / custom bot)
# NOTIFICATION_WEBHOOK_URL=https://hooks.example.com/xyz

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=info